# =============================================================================
# SportHub — Environment Variables
# copy ไฟล์นี้เป็น .env.local แล้วกรอกค่าจริง — ห้าม commit .env.local
# =============================================================================

# ---- Supabase (Dashboard > Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# server-side เท่านั้น ห้ามหลุดไป client / ห้ามใส่ prefix NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# ---- Omise (B2B Subscription) — https://dashboard.omise.co ----
OMISE_PUBLIC_KEY=
OMISE_SECRET_KEY=
OMISE_WEBHOOK_SECRET=

# ---- LINE Messaging API — https://developers.line.biz ----
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ---- SendGrid — https://app.sendgrid.com ----
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# พร้อมเพย์ของ SportHub เอง — รับชำระ Subscription จากสนาม (§11.2 เส้นทาง PromptPay)
SPORTHUB_PROMPTPAY_ID=
# secret กัน endpoint /api/cron/* (ตั้งค่าเดียวกับ Vercel Cron header)
CRON_SECRET=
# secret สำหรับเซ็น QR บัตรสมาชิก (แนะนำอย่างน้อย 32 ตัวอักษร; ว่างไว้จะใช้ CRON_SECRET)
MEMBER_QR_SECRET=

# ---- Rate limit ข้าม instance (ไม่บังคับ — ว่างไว้ = ใช้ in-memory ต่อ instance) ----
# แนะนำบน Vercel serverless: สร้าง Upstash Redis (ฟรี) แล้ววาง REST URL/TOKEN
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- OCR ตรวจยอดสลิปอัตโนมัติ (ไม่บังคับ — ว่างไว้ = ตรวจด้วยมือเหมือนเดิม) ----
# สัญญา API: POST { imageUrl } -> { text }
OCR_API_URL=
OCR_API_KEY=

# ---- Error monitoring (ไม่บังคับ — ต้องติดตั้ง @sentry/nextjs เพิ่มถ้าจะใช้จริง) ----
SENTRY_DSN=
# DSN สำหรับจับ error ฝั่ง browser (ใส่ค่าเดียวกับ SENTRY_DSN ได้ — ไม่ใส่ = ไม่ดัก client error)
NEXT_PUBLIC_SENTRY_DSN=

# ---- LINE Login + LIFF (ลูกค้าสมัคร/เข้าสู่ระบบด้วย LINE + บัตร/ประวัติในแอป LINE) ----
# สร้าง LINE Login channel ที่ https://developers.line.biz แล้วเพิ่ม LIFF app
# ในหน้า LINE Login → ตั้ง Callback URL = {NEXT_PUBLIC_APP_URL}/api/auth/line/callback
# และเปิดสิทธิ์ scope: openid, profile, email (email ต้องขออนุมัติ) — ไม่ใส่ = ปุ่ม LINE จะซ่อน/ไม่ crash
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
NEXT_PUBLIC_LIFF_ID=
# ขอ scope email ด้วยไหม (ต้องยื่นอนุมัติ email permission ในคอนโซลก่อน) — default = ไม่ขอ
LINE_LOGIN_SCOPE_EMAIL=

# ---- Google AdSense (รายได้โฆษณา — ใส่หลัง Google อนุมัติ) ----
# รูปแบบ: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT=
